# macOS
.DS_Store

# Microsoft Office lock files (created while a .docx is open)
~$*.docx
~$*.doc

# Internal/confidential design docs — kept locally, never pushed.
# (Screenshots and diagrams pulled from them live in docs-images/ instead.)
docs/

# Canvas Apps editor-only state (per-user layout/zoom/selection; regenerated by
# `pac canvas unpack` and `pac canvas pack` — not meaningful to diff or merge)
**/_EditorState.pa.yaml
